#!/usr/bin/env bash
set -euo pipefail

CI_MODE=false
[[ "${1:-}" == "--ci" ]] && CI_MODE=true

say()  { printf "\n\033[1m%s\033[0m\n" "$1"; }
fail() { printf "\n❌ %s\n   → %s\n" "$1" "$2"; exit 1; }

offer_install() { # $1=name $2=brew formula $3=manual url
  if $CI_MODE; then fail "$1 is missing" "Install it: $3"; fi
  if command -v brew >/dev/null 2>&1; then
    read -r -p "$1 is missing. Install via Homebrew? [y/N] " answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then brew install "$2"; return; fi
  fi
  fail "$1 is required" "Install it manually: $3"
}

initial_commit() { # your first commit — respect a configured identity, else fall back
  git add -A
  if git config user.email >/dev/null 2>&1; then
    git commit -q -m "chore: start from liftkit-template"
  else
    git -c user.name="Liftkit" -c user.email="liftkit@localhost" \
      commit -q -m "chore: start from liftkit-template"
  fi
}

say "Liftkit bootstrap — checking prerequisites"

command -v git  >/dev/null 2>&1 || offer_install "git" "git" "https://git-scm.com/downloads"
command -v node >/dev/null 2>&1 || offer_install "Node.js" "node" "https://nodejs.org"

NODE_MAJOR=$(node -e 'console.log(process.versions.node.split(".")[0])')
[[ "$NODE_MAJOR" -ge 22 ]] || fail "Node >= 22 required (found $(node -v))" "Update: https://nodejs.org or 'nvm install 22'"

command -v pnpm >/dev/null 2>&1 || corepack enable || offer_install "pnpm" "pnpm" "https://pnpm.io/installation"

# Make this a standalone copy of the template — its own git history, no remote
# pointing back upstream — so /update copies future releases in without ever
# merging against a fork. GitHub's "Use this template" already does this; the two
# branches below only catch the off-path cases (archive download, or a raw clone
# of the template repo). Must run before `pnpm install`, so lefthook's prepare
# hook has a repo to attach to. Left untouched in CI (--ci), which verifies the
# buyer's first run against a throwaway repo.
say "Making this your own project (git)"
if [[ ! -d .git ]]; then
  # Downloaded as an archive: no repo at all, and /liftoff needs one to commit.
  git init -q
  initial_commit
  printf "Started a fresh git repository with your first commit.\n"
elif ! $CI_MODE && git remote get-url origin >/dev/null 2>&1 \
  && git remote get-url origin | grep -q "liftkit-template"; then
  # Cloned the template directly: origin still points back at the template repo.
  printf "You cloned the template directly, so git still points back at it.\n"
  printf "The recommended path is GitHub's \"Use this template\", which gives your\n"
  printf "project its own clean history.\n"
  # Only offer the destructive reset when a human is at the terminal. read lives
  # inside the condition so an EOF (piped/non-interactive stdin) short-circuits
  # to the safe branch instead of aborting under `set -e`.
  if [[ -t 0 ]] && read -r -p "Reset git to a single fresh commit now? [Y/n] " answer \
    && [[ ! "$answer" =~ ^[Nn]$ ]]; then
    rm -rf .git
    git init -q
    initial_commit
    printf "Reset to a fresh history — this is now your own repository.\n"
  else
    git remote remove origin
    printf "Removed the template remote; your history is untouched.\n"
    printf "Run 'rm -rf .git && git init' yourself for a clean slate if you want one.\n"
  fi
else
  printf "Git looks good — your project has its own history.\n"
fi

say "Installing dependencies"
if pnpm install --frozen-lockfile; then
  :
else
  say "Frozen lockfile install failed — falling back to a regular install (lockfile may be updated)"
  pnpm install
fi

if [[ ! -f .env ]]; then
  cp .env.example .env
  say "Created .env from .env.example (defaults: PGlite, zero external services)"
fi

say "Initializing local database (PGlite) — migrate + seed"
pnpm db:migrate
pnpm db:seed

say "✅ Bootstrap complete."
printf "Local data note: your database lives in ./.pglite/ — it survives restarts,\n"
printf "but it is not in git (fresh clone or deleting the folder = empty database).\n"
printf "See README → 'Where your local data lives'.\n"
printf "\nNext step: open Claude Code in this folder and type \033[1m/liftoff\033[0m\n"
printf "Optional: QA copilot plugin — /plugin marketplace add grooownow/qa-pilot\n"
