{
  "name": "liftkit",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "next build",
    "build:ru-static": "tsx scripts/build-ru-static.ts",
    "start": "next start --port 3210",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && eslint . && prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "bootstrap": "./scripts/bootstrap",
    "skills:gen": "tsx scripts/gen-skills.ts",
    "skills:check": "tsx scripts/gen-skills.ts --check",
    "skills:validate": "tsx scripts/validate-skills.ts",
    "skills:evals": "tsx scripts/skill-evals.ts",
    "skills:evals:behavioral": "tsx scripts/skill-evals.ts --behavioral",
    "skills:evals:detection": "tsx scripts/skill-detection-eval.ts",
    "prepare": "command -v git >/dev/null 2>&1 && lefthook install || true",
    "db:reset": "rm -rf .pglite && pnpm db:migrate && pnpm db:seed"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/drizzle-adapter": "^1.11.2",
    "@electric-sql/pglite": "^0.5.4",
    "@sentry/nextjs": "^10.64.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.23.0",
    "next": "^16.2.11",
    "next-auth": "5.0.0-beta.32",
    "next-mdx-remote-client": "^2.1.11",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "posthog-js": "^1.398.2",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.0.2",
    "eslint-plugin-oxlint": "^1.73.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.9",
    "oxlint": "^1.73.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
