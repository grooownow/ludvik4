# Database: pglite (default, zero deps) | remote (needs DATABASE_URL)
LIFTKIT_DB=pglite
# DATABASE_URL=postgres://liftkit:liftkit@localhost:5432/liftkit

# --- App ---
# Public app URL, used in metadata (sitemap, robots, OG). Default: http://localhost:3210
# Set this per market to that market's own domain — never the other market's.
# NEXT_PUBLIC_APP_URL=https://example.com

# Which market this build serves: ru (Russian, includes blog + RSS) | en
# (international, no Russian blog). Selects language, copy, metadata, JSON-LD and
# which routes are published. One build = one market, no runtime switcher.
# Default: ru
# SITE_MARKET=ru

# --- Auth (all optional — skeleton boots with zero config) ---
# Required for any auth flow (sign-in/callback routes 500 without it).
# Generate with: npx auth secret
# AUTH_SECRET=
# Set to true when self-hosting behind a trusted proxy / for local prod-mode
# runs; Vercel is auto-trusted. Without it, /api/auth/* returns 500
# UntrustedHost under `pnpm start` (and any other non-Vercel prod host).
# AUTH_TRUST_HOST=
# GitHub OAuth app client ID
# AUTH_GITHUB_ID=
# GitHub OAuth app client secret
# AUTH_GITHUB_SECRET=
# Google OAuth client ID
# AUTH_GOOGLE_ID=
# Google OAuth client secret
# AUTH_GOOGLE_SECRET=

# --- Auth: local login (credentials) ---
# Dev bypass: when true, you are auto-logged-in as the seeded admin and
# /dashboard needs no sign-in. It lives in `.env.development` (loaded only by
# `pnpm dev`), NOT here — a value in this file would also apply to
# `pnpm build`/`pnpm start`, and the app refuses to run in production with the
# bypass on. Flip it off in `.env.development` to exercise the real login.
# Seeded admin login (dev defaults shown; the sign-in page uses these).
# The seed hashes the password and refuses to run in production.
# SEED_ADMIN_EMAIL=admin@example.local
# SEED_ADMIN_PASSWORD=dev-admin-pw

# --- Observability (all optional) ---
# Sentry DSN for server + edge error reporting (request errors, via
# instrumentation.ts's onRequestError hook). No source-map upload is
# configured here — see src/sentry.server.config.ts for why, and set up
# SENTRY_AUTH_TOKEN in your deploy pipeline when you're ready for that.
# SENTRY_DSN=
# Same Sentry DSN, mirrored with the NEXT_PUBLIC_ prefix to also enable
# browser-side error capture (src/instrumentation-client.ts). DSNs are not
# secrets — safe to expose client-side. Separate var because only
# NEXT_PUBLIC_-prefixed vars are inlined into client bundles.
# NEXT_PUBLIC_SENTRY_DSN=
# Log verbosity: fatal | error | warn | info | debug | trace (default: info)
# LOG_LEVEL=info

# --- Analytics (all optional) ---
# PostHog public API key (browser-exposed via NEXT_PUBLIC_ prefix)
# NEXT_PUBLIC_POSTHOG_KEY=

# --- SEO verification (all optional) ---
# Ownership-verification meta-tag tokens. Unset → no meta tag is emitted.
# Google Search Console: the `content` value of the meta tag it offers
# (HTML-tag verification method).
# GOOGLE_SITE_VERIFICATION=
# Yandex.Webmaster: same — the meta-tag `content` token.
# YANDEX_VERIFICATION=

# --- Lead form (contact) — all optional in local development ---
# With these unset, the form logs a warning locally. All three Resend variables
# are required on the live EN site; form submissions are delivered only by
# email. Verify ludvik4.dev in Resend before using its address as the sender.
# RESEND_API_KEY=
# LEAD_EMAIL_TO=ludvik4good.me@gmail.com
# LEAD_EMAIL_FROM=Ludvik4 <hi@ludvik4.dev>
#
# Cloudflare Turnstile spam captcha (both keys switch it on):
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
