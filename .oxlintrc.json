{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "ignorePatterns": ["next-env.d.ts", "tests/fixtures/planted-defects/**"],
  "rules": {
    "no-console": "error",
    "no-empty": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "server-only", "@testing-library/jest-dom/vitest"]
      }
    ]
  },
  "overrides": [{ "files": ["scripts/**"], "rules": { "no-console": "off" } }]
}
