# Development-only environment. Next loads this file when NODE_ENV=development
# (i.e. `pnpm dev`) and ignores it for `pnpm build` / `pnpm start`, so nothing
# here can reach a production build. Committed on purpose — it is the dev
# default, not a secret. Override any line in `.env.local` (gitignored).

# Auto-sign-in as the seeded admin so local runs skip the sign-in page.
# Set to false here to exercise the real email/password login instead.
AUTH_DEV_BYPASS=true
